body{
  margin:0;
  padding:0;
  background:#f8edeb;
  font-family:Georgia, serif;
  text-align:center;
  color:#5e4b4b;
}

.container{
  padding:40px 20px;
}

.main-image{
  width:260px;
  border-radius:20px;
  margin-top:20px;
  box-shadow:0px 4px 15px rgba(0,0,0,0.2);
}

h1{
  margin-top:30px;
  font-size:40px;
}

.small-message,
.long-message{
  max-width:700px;
  margin:auto;
  line-height:1.9;
  font-size:20px;
  padding:20px;
}

.audio{
  margin-top:20px;
}

.button{
  display:inline-block;
  margin-top:30px;
  padding:12px 28px;
  background:#d38c8c;
  color:white;
  text-decoration:none;
  border-radius:30px;
  transition:0.3s;
}

.button:hover{
  background:#b56c6c;
}
